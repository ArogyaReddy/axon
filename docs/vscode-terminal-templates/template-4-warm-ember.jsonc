{
  "workbench.colorTheme": "Default Dark Modern",
  "window.autoDetectColorScheme": false,
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "editor.minimap.enabled": false,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.showActions": "singleTerminal",
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.sideBar.location": "right",
  "window.density.layout": "compact",
  "workbench.activityBar.compact": true,
  "workbench.colorCustomizations": {
    "editor.background": "#201815",
    "editor.foreground": "#F1DFD1",
    "editorLineNumber.foreground": "#80665A",
    "editorLineNumber.activeForeground": "#F1DFD1",
    "sideBar.background": "#201815",
    "sideBar.foreground": "#F1DFD1",
    "sideBar.border": "#493127",
    "panel.background": "#201815",
    "panel.border": "#493127",
    "titleBar.activeBackground": "#201815",
    "titleBar.activeForeground": "#F1DFD1",
    "activityBar.background": "#201815",
    "activityBar.foreground": "#F0A35B",
    "activityBar.inactiveForeground": "#80665A",
    "statusBar.background": "#34231B",
    "statusBar.foreground": "#F1DFD1",
    "editorGroupHeader.tabsBackground": "#201815",
    "tab.activeBackground": "#34231B",
    "tab.activeForeground": "#F1DFD1",
    "tab.inactiveBackground": "#17100D",
    "tab.inactiveForeground": "#A98C7E",
    "input.background": "#34231B",
    "dropdown.background": "#34231B",
    "list.background": "#201815",
    "list.hoverBackground": "#4A2F22",
    "list.activeSelectionBackground": "#6B4027",
    "focusBorder": "#F0A35B",
    "terminal.background": "#201815",
    "terminal.foreground": "#F1DFD1",
    "terminalCursor.background": "#F1DFD1",
    "terminalCursor.foreground": "#201815",
    "terminal.ansiBlack": "#201815",
    "terminal.ansiBlue": "#78A9C9",
    "terminal.ansiBrightBlack": "#80665A",
    "terminal.ansiBrightBlue": "#9BC9E8",
    "terminal.ansiBrightCyan": "#6CC7C2",
    "terminal.ansiBrightGreen": "#B4CF86",
    "terminal.ansiBrightMagenta": "#D3A1C2",
    "terminal.ansiBrightRed": "#FF9A82",
    "terminal.ansiBrightWhite": "#FFF4EA",
    "terminal.ansiBrightYellow": "#F3C879",
    "terminal.ansiCyan": "#4E9C99",
    "terminal.ansiGreen": "#879E5B",
    "terminal.ansiMagenta": "#AA718E",
    "terminal.ansiRed": "#D06E58",
    "terminal.ansiWhite": "#F1DFD1",
    "terminal.ansiYellow": "#C69A52"
  }
}
