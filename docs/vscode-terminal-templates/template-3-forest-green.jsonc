{
  "workbench.colorTheme": "Default Dark Modern",
  "window.autoDetectColorScheme": false,
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "editor.minimap.enabled": false,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.showActions": "singleTerminal",
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.sideBar.location": "right",
  "window.density.layout": "compact",
  "workbench.activityBar.compact": true,
  "workbench.colorCustomizations": {
    "editor.background": "#122019",
    "editor.foreground": "#D6E6D2",
    "editorLineNumber.foreground": "#5D7964",
    "editorLineNumber.activeForeground": "#D6E6D2",
    "sideBar.background": "#122019",
    "sideBar.foreground": "#D6E6D2",
    "sideBar.border": "#294535",
    "panel.background": "#122019",
    "panel.border": "#294535",
    "titleBar.activeBackground": "#122019",
    "titleBar.activeForeground": "#D6E6D2",
    "activityBar.background": "#122019",
    "activityBar.foreground": "#88C98B",
    "activityBar.inactiveForeground": "#5D7964",
    "statusBar.background": "#1B3023",
    "statusBar.foreground": "#D6E6D2",
    "editorGroupHeader.tabsBackground": "#122019",
    "tab.activeBackground": "#1B3023",
    "tab.activeForeground": "#D6E6D2",
    "tab.inactiveBackground": "#0D1712",
    "tab.inactiveForeground": "#819B87",
    "input.background": "#1B3023",
    "dropdown.background": "#1B3023",
    "list.background": "#122019",
    "list.hoverBackground": "#21402D",
    "list.activeSelectionBackground": "#2C5B3B",
    "focusBorder": "#88C98B",
    "terminal.background": "#122019",
    "terminal.foreground": "#D6E6D2",
    "terminalCursor.background": "#D6E6D2",
    "terminalCursor.foreground": "#122019",
    "terminal.ansiBlack": "#122019",
    "terminal.ansiBlue": "#7BA7D8",
    "terminal.ansiBrightBlack": "#5D7964",
    "terminal.ansiBrightBlue": "#9AC4F2",
    "terminal.ansiBrightCyan": "#72D1C0",
    "terminal.ansiBrightGreen": "#B6E39B",
    "terminal.ansiBrightMagenta": "#D0A5D8",
    "terminal.ansiBrightRed": "#F28B82",
    "terminal.ansiBrightWhite": "#F0F7ED",
    "terminal.ansiBrightYellow": "#E4D38B",
    "terminal.ansiCyan": "#4DAA9A",
    "terminal.ansiGreen": "#78A85F",
    "terminal.ansiMagenta": "#A875B5",
    "terminal.ansiRed": "#CC6B63",
    "terminal.ansiWhite": "#D6E6D2",
    "terminal.ansiYellow": "#C9B86F"
  }
}
