{
  "workbench.colorTheme": "Default Dark Modern",
  "window.autoDetectColorScheme": false,
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "editor.minimap.enabled": false,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.showActions": "singleTerminal",
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.sideBar.location": "right",
  "window.density.layout": "compact",
  "workbench.activityBar.compact": true,
  "workbench.colorCustomizations": {
    "editor.background": "#101416",
    "editor.foreground": "#E5F5F2",
    "editorLineNumber.foreground": "#5D7777",
    "editorLineNumber.activeForeground": "#E5F5F2",
    "sideBar.background": "#101416",
    "sideBar.foreground": "#E5F5F2",
    "sideBar.border": "#294244",
    "panel.background": "#101416",
    "panel.border": "#294244",
    "titleBar.activeBackground": "#101416",
    "titleBar.activeForeground": "#E5F5F2",
    "activityBar.background": "#101416",
    "activityBar.foreground": "#44C2B4",
    "activityBar.inactiveForeground": "#5D7777",
    "statusBar.background": "#193033",
    "statusBar.foreground": "#E5F5F2",
    "editorGroupHeader.tabsBackground": "#101416",
    "tab.activeBackground": "#193033",
    "tab.activeForeground": "#E5F5F2",
    "tab.inactiveBackground": "#0B0F10",
    "tab.inactiveForeground": "#8AA8A7",
    "input.background": "#193033",
    "dropdown.background": "#193033",
    "list.background": "#101416",
    "list.hoverBackground": "#1D4144",
    "list.activeSelectionBackground": "#286267",
    "focusBorder": "#44C2B4",
    "terminal.background": "#101416",
    "terminal.foreground": "#E5F5F2",
    "terminalCursor.background": "#E5F5F2",
    "terminalCursor.foreground": "#101416",
    "terminal.ansiBlack": "#101416",
    "terminal.ansiBlue": "#6EA8D4",
    "terminal.ansiBrightBlack": "#5D7777",
    "terminal.ansiBrightBlue": "#94C9F1",
    "terminal.ansiBrightCyan": "#71E2D2",
    "terminal.ansiBrightGreen": "#B7E69A",
    "terminal.ansiBrightMagenta": "#D9A6E0",
    "terminal.ansiBrightRed": "#FF928D",
    "terminal.ansiBrightWhite": "#F5FFFD",
    "terminal.ansiBrightYellow": "#F2D27D",
    "terminal.ansiCyan": "#44C2B4",
    "terminal.ansiGreen": "#8CBF75",
    "terminal.ansiMagenta": "#B97BC6",
    "terminal.ansiRed": "#D96F6B",
    "terminal.ansiWhite": "#E5F5F2",
    "terminal.ansiYellow": "#D2AE57"
  }
}
