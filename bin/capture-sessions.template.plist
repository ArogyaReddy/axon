<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!--
    TEMPLATE — do not launchctl load this file directly.
    __HOME__ and __PYTHON3__ are placeholders substituted by
    install-capture-sessions at install time. launchd does NOT expand
    $HOME/~ itself in WatchPaths/StandardOutPath/StandardErrorPath — this was
    verified directly (see docs/guides/ar-session-log-sharing-guide.md) —
    so a per-user file with real resolved paths must be generated, not this
    template loaded as-is.
  -->

  <key>Label</key>
  <string>com.arog.capture-sessions</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3__</string>
    <string>__HOME__/.claude/bin/capture-sessions</string>
  </array>

  <key>WatchPaths</key>
  <array>
    <string>__HOME__/Library/Application Support/Code/User/workspaceStorage</string>
    <string>__HOME__/Library/Application Support/Code - Insiders/User/workspaceStorage</string>
    <string>__HOME__/.claude/projects</string>
    <string>__HOME__/.claude/history.jsonl</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.claude/logs/capture-sessions.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/logs/capture-sessions.err</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>

</dict>
</plist>
