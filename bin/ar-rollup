#!/usr/bin/env node
/**
 * ar-rollup — AROG Gap 4: Historical Rollup & Recurring-Bug Detection
 *
 * Zero-AI. Reads session-env dated folders' stop-{sessionId}.json files
 * (Gap 5's structured result artifacts) PLUS mined pseudo-artifacts from the
 * older docs/sessions/*.md archive (verified to go back to 2026-04-01 --
 * far deeper than session-env/'s 5-6 days) and aggregates them.
 *
 * Commands:
 *   ar-rollup show [--days N] [--branch <name>]   — terminal summary
 *   ar-rollup report [--date YYYY-MM-DD] [--branch <name>]
 *                                                  — writes docs/reports/YYYY-MM-DD.md
 *   ar-rollup build [--branch <name>]             — writes docs/reports/dashboard.html
 *
 * NOTE: this does NOT install a cron job / LaunchAgent. Run manually, or add
 * your own scheduled trigger — see the printed suggestion at the bottom of
 * `report`'s output.
 */

const fs = require("fs");
const path = require("path");
const os = require("os");

const {
  aggregateByDay,
  detectRecurringFiles,
  loadStopArtifacts,
  filterByBranch,
  mergeArtifacts,
} = require("../hooks/lib/rollup-aggregate.js");
const { mineSessionLogs } = require("../hooks/lib/mine-session-logs.js");
const { renderDashboardHtml } = require("../hooks/lib/rollup-html.js");

const REPORTS_DIR = path.join(os.homedir(), ".claude", "docs", "reports");
const SESSIONS_DIR = path.join(os.homedir(), ".claude", "docs", "sessions");

function loadAllArtifacts() {
  const stopArtifacts = loadStopArtifacts();
  const legacyArtifacts = mineSessionLogs(SESSIONS_DIR);
  return mergeArtifacts(stopArtifacts, legacyArtifacts);
}

function dateNDaysAgo(n) {
  const d = new Date();
  d.setDate(d.getDate() - n);
  return d.toISOString().slice(0, 10);
}

function renderRollupText(byDay, recurring, label) {
  const lines = [];
  lines.push(`\n== AROG Rollup — ${label} ==`);
  const days = Object.keys(byDay).sort();
  if (days.length === 0) {
    lines.push("  (no sessions in this window)");
  }
  let totalSessions = 0;
  for (const day of days) {
    const d = byDay[day];
    totalSessions += d.total;
    const rate =
      d.passRate === null ? "n/a" : (d.passRate * 100).toFixed(0) + "%";
    lines.push(
      `  ${day}  sessions:${d.total}  verified:${d.verified}  failed:${d.failed}  open:${d.open}  passRate:${rate}`,
    );
  }
  lines.push(`  --`);
  lines.push(`  Total sessions in window: ${totalSessions}`);
  lines.push("");
  lines.push("  Recurring file churn (3+ distinct sessions):");
  if (recurring.length === 0) {
    lines.push("    (none)");
  } else {
    for (const r of recurring.slice(0, 10)) {
      lines.push(`    ${r.file}  — touched in ${r.sessionCount} sessions`);
    }
  }
  return lines.join("\n");
}

function cmdShow(args) {
  const daysIdx = args.indexOf("--days");
  const days = daysIdx !== -1 ? parseInt(args[daysIdx + 1], 10) : 7;
  const cutoff = dateNDaysAgo(days);
  const branchIdx = args.indexOf("--branch");
  const branch = branchIdx !== -1 ? args[branchIdx + 1] : null;

  const all = filterByBranch(loadAllArtifacts(), branch);
  const windowed = all.filter((a) => a.date && a.date >= cutoff);
  const byDay = aggregateByDay(windowed);
  const recurring = detectRecurringFiles(windowed, 3);

  const label = `last ${days} day(s)` + (branch ? ` on branch "${branch}"` : "");
  console.log(renderRollupText(byDay, recurring, label));
}

function cmdReport(args) {
  const dateIdx = args.indexOf("--date");
  const targetDate =
    dateIdx !== -1 ? args[dateIdx + 1] : new Date().toISOString().slice(0, 10);
  const branchIdx = args.indexOf("--branch");
  const branch = branchIdx !== -1 ? args[branchIdx + 1] : null;

  const all = filterByBranch(loadAllArtifacts(), branch);
  const dayArtifacts = all.filter((a) => a.date === targetDate);
  const byDay = aggregateByDay(dayArtifacts);
  const recurring = detectRecurringFiles(all, 3); // recurring detection uses full history, not just 1 day

  const d = byDay[targetDate] || {
    total: 0,
    verified: 0,
    failed: 0,
    open: 0,
    passRate: null,
  };
  const rate = d.passRate === null ? "n/a" : (d.passRate * 100).toFixed(0) + "%";

  const md = [
    `# AROG Daily Report — ${targetDate}`,
    "",
    `- Sessions: ${d.total}`,
    `- Verified: ${d.verified}`,
    `- Failed: ${d.failed}`,
    `- Open (no test data): ${d.open}`,
    `- Pass rate (verified / (verified+failed)): ${rate}`,
    "",
    "## Recurring File Churn (3+ distinct sessions, all-time)",
    recurring.length === 0
      ? "(none)"
      : recurring
          .slice(0, 20)
          .map((r) => `- \`${r.file}\` — touched in ${r.sessionCount} sessions`)
          .join("\n"),
    "",
    `_Generated by \`ar-rollup report\` — zero AI, aggregated from ${all.length} real artifacts (session-env/ stop files + mined docs/sessions/*.md archive)._`,
  ].join("\n");

  fs.mkdirSync(REPORTS_DIR, { recursive: true });
  const outFile = path.join(REPORTS_DIR, `${targetDate}.md`);
  fs.writeFileSync(outFile, md);
  console.log("Report written: " + outFile);
  console.log(
    "\nTo automate daily: add a cron/LaunchAgent entry yourself, e.g.:",
  );
  console.log(
    `  0 8 * * * node ${path.join(os.homedir(), ".claude", "bin", "ar-rollup")} report`,
  );
}

function cmdBuild(args) {
  const branchIdx = args.indexOf("--branch");
  const branch = branchIdx !== -1 ? args[branchIdx + 1] : null;

  const all = filterByBranch(loadAllArtifacts(), branch);
  const byDay = aggregateByDay(all);
  const recurring = detectRecurringFiles(all, 3);

  const html = renderDashboardHtml({ all, byDay, recurring, branch, days: null, liveControls: false });

  fs.mkdirSync(REPORTS_DIR, { recursive: true });
  const outFile = path.join(REPORTS_DIR, "dashboard.html");
  fs.writeFileSync(outFile, html);
  console.log("Dashboard built: " + outFile);
  console.log("Open: file://" + outFile);
}

const args = process.argv.slice(2);
const cmd = args[0] || "show";

switch (cmd) {
  case "show":
    cmdShow(args.slice(1));
    break;
  case "report":
    cmdReport(args.slice(1));
    break;
  case "build":
    cmdBuild(args.slice(1));
    break;
  default:
    console.log("Usage: ar-rollup [show|report|build]");
    console.log("  show [--days N] [--branch <name>]            — terminal summary (default 7 days)");
    console.log("  report [--date YYYY-MM-DD] [--branch <name>] — writes docs/reports/YYYY-MM-DD.md (default: today)");
    console.log("  build [--branch <name>]                      — writes docs/reports/dashboard.html");
}
