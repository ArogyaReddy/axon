<script>
function show(id) {
  document.querySelectorAll('.panel').forEach(function(p){ p.style.display='none'; });
  document.querySelectorAll('.nav-tab,.nav-overview').forEach(function(t){ t.classList.remove('active'); });
  var panel = document.getElementById('panel-' + id);
  if (panel) panel.style.display = 'block';
  var tab = document.getElementById('tab-' + id);
  if (tab) tab.classList.add('active');
}
// Show overview on load
show('overview');
</script>
</body>
</html>`;

  fs.writeFileSync(TRACKER_HTML, html);
  console.log("Tracker built: " + TRACKER_HTML);
  console.log("Open: file://" + TRACKER_HTML);
}

// ── MAIN ─────────────────────────────────────────────────────────────────────
const args = process.argv.slice(2);
const cmd = args[0] || "show";
const data = load();

switch (cmd) {
  case "show":
    cmdShow(data);
    break;
  case "build":
    cmdBuild(data);
    break;
  case "update":
    cmdUpdate(data, args.slice(1));
    cmdBuild(data);
    break;
  case "session":
    cmdSession(data, args.slice(1));
    cmdBuild(data);
    break;
  case "classify":
    cmdClassify(data, args.slice(1));
    cmdBuild(data);
    break;
  case "close":
    cmdClose(data, args.slice(1));
    cmdBuild(data);
    break;
  case "trace":
    cmdTrace(data, args.slice(1));
    break;
  default:
    console.log("Usage: ar-tracker [show|build|update|session|close|trace]");
    console.log(
      "  build                              — regenerate tracker.html",
    );
    console.log("  show                               — terminal summary");
    console.log("  update <id> --pct 75 --status done — update a gap");
    console.log('  session <id> --what "..." [--verified] [--evidence "..."]');
    console.log('  close <session-id> --evidence "..."');
    console.log(
      "  trace <session-id|short-id>        — joined req+session+outcome view",
    );
}
