      \${unclassified.map(s => {
        const hint  = s.gap_hint ? \` <span style="color:#a78bfa;font-size:11px">[hint: \${escHtml(s.gap_hint)} · \${escHtml(s.gap_hint_confidence)}]</span>\` : '';
        const tests = s.test_state ? (s.test_state.tests_ran ? \`✅ \${s.test_state.pass_count}P/\${s.test_state.fail_count}F\` : '⚠️ no tests') : '—';
        const req   = s.req ? escHtml(s.req.raw.slice(0, 120).replace(/\\n/g,' ')) : '(no req captured)';
        return \`<div class="session-row" style="border-color:#3b1fa8">
          <div class="session-date">\${escHtml(s.date)}<br><span style="font-size:10px;color:#7c3aed">\${escHtml(s.short_id)}</span></div>
          <div><div class="session-what">\${req}\${hint}</div>
          <div style="font-size:11px;color:#64748b;margin-top:4px">Tests: \${tests} · Files: \${s.changed_files.length}</div>
          <code style="font-size:11px;color:#7c3aed;display:block;margin-top:4px">ar-tracker classify \${escHtml(s.gap_hint || '&lt;gap-id&gt;')} \${escHtml(s.short_id)}</code></div>
          <div class="session-status open">UNCLASSIFIED</div>
        </div>\`;
      }).join('')}
    </div>\` : ''}
  </div>

