def strip_jsonc_comments(text: str) -> str:
    """Remove comments outside strings so JSONC can be parsed with stdlib JSON."""
    result: list[str] = []
    in_string = False
    escaped = False
    in_line_comment = False
    in_block_comment = False
    index = 0
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
                result.append(char)
            else:
                result.append(" ")
        elif in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
                result.extend("  ")
                index += 1
            elif char == "\n":
                result.append(char)
            else:
                result.append(" ")
        elif in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
            result.append(char)
        elif char == "/" and next_char == "/":
            in_line_comment = True
            result.extend("  ")
            index += 1
        elif char == "/" and next_char == "*":
            in_block_comment = True
            result.extend("  ")
            index += 1
        else:
            result.append(char)
        index += 1
    return "".join(result)


def load_jsonc(path: Path) -> dict:
    try:
        return json.loads(strip_jsonc_trailing_commas(strip_jsonc_comments(path.read_text())))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Could not parse {path}: {error}") from error


def strip_jsonc_trailing_commas(text: str) -> str:
    result: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        if in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
            result.append(char)
        elif char == ",":
            lookahead = index + 1
            while lookahead < len(text) and text[lookahead].isspace():
                lookahead += 1
            if lookahead >= len(text) or text[lookahead] not in "}]":
                result.append(char)
        else:
            result.append(char)
        index += 1
    return "".join(result)


def find_matching_brace(text: str, opening: int) -> int:
    depth = 0
    in_string = False
    escaped = False
    in_line_comment = False
    in_block_comment = False
    for index in range(opening, len(text)):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
            continue
        if in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
            continue
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
        elif char == "/" and next_char == "/":
            in_line_comment = True
        elif char == "/" and next_char == "*":
            in_block_comment = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return index
    raise RuntimeError("Could not find the end of workbench.colorCustomizations")


def find_root_opening(text: str) -> int:
    in_string = False
    escaped = False
    in_line_comment = False
    in_block_comment = False
    index = 0
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
            index += 1
            continue
        if in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
                index += 2
            else:
                index += 1
            continue
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
        elif char == "/" and next_char == "/":
            in_line_comment = True
            index += 2
            continue
        elif char == "/" and next_char == "*":
            in_block_comment = True
            index += 2
            continue
        elif char == "{":
            return index
        index += 1
    raise RuntimeError("Settings file has no root object")


def infer_top_level_indent(text: str, opening: int, closing: int) -> str:
    for line in text[opening + 1 : closing].splitlines():
        stripped = line.lstrip(" \t")
        if stripped.startswith('"'):
            return line[: len(line) - len(stripped)]
    return "  "


def find_top_level_key(text: str, key: str) -> dict | None:
    depth = 0
    in_line_comment = False
    in_block_comment = False
    index = 0
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
            index += 1
            continue
        if in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
                index += 2
            else:
                index += 1
            continue
        if char == "/" and next_char == "/":
            in_line_comment = True
            index += 2
            continue
        if char == "/" and next_char == "*":
            in_block_comment = True
            index += 2
            continue
        if char == '"':
            string_end = index + 1
            escaped = False
            while string_end < len(text):
                if escaped:
                    escaped = False
                elif text[string_end] == "\\":
                    escaped = True
                elif text[string_end] == '"':
                    break
                string_end += 1
            if depth == 1 and string_end < len(text):
                try:
                    parsed_key = json.loads(text[index : string_end + 1])
                except json.JSONDecodeError:
                    parsed_key = None
                after_key = skip_jsonc_whitespace(text, string_end + 1)
                if parsed_key == key and after_key < len(text) and text[after_key] == ":":
                    value_start = skip_jsonc_whitespace(text, after_key + 1)
                    line_start = text.rfind("\n", 0, index) + 1
                    line_end = text.find("\n", index)
                    if line_end == -1:
                        line_end = len(text)
                    line = text[line_start:line_end]
                    indent = line[: len(line) - len(line.lstrip(" \t"))]
                    return {
                        "line_start": line_start,
                        "line_end": line_end,
                        "indent": indent,
                        "value_start": value_start,
                    }
            index = string_end + 1
            continue
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
        index += 1
    return None


def skip_jsonc_whitespace(text: str, start: int) -> int:
    index = start
    while index < len(text):
        while index < len(text) and text[index].isspace():
            index += 1
        if text.startswith("//", index):
            newline = text.find("\n", index + 2)
            index = len(text) if newline == -1 else newline + 1
            continue
        if text.startswith("/*", index):
            closing = text.find("*/", index + 2)
            index = len(text) if closing == -1 else closing + 2
            continue
        return index
    return index


def replace_object(text: str, key: str, value: dict) -> str:
    entry = find_top_level_key(text, key)
    if entry is None or text[entry["value_start"]] != "{":
        raise RuntimeError(f"Required setting is missing: {key}")
    opening = entry["value_start"]
    closing = find_matching_brace(text, opening)
    indent = entry["indent"]
    pretty_lines = json.dumps(value, indent=2).splitlines()
    nested_indent = indent if indent else "  "
    pretty_lines = [pretty_lines[0]] + [
        nested_indent + line[2:] if line.startswith("  ") else line
        for line in pretty_lines[1:]
    ]
    formatted = pretty_lines[0] + "\n"
    formatted += "\n".join(indent + line for line in pretty_lines[1:])
    return text[:opening] + formatted + text[closing + 1 :]


def find_last_top_level_entry(text: str) -> dict | None:
    depth = 0
    in_line_comment = False
    in_block_comment = False
    last_entry = None
    index = 0
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
            index += 1
            continue
        if in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
                index += 2
            else:
                index += 1
            continue
        if char == "/" and next_char == "/":
            in_line_comment = True
            index += 2
            continue
        if char == "/" and next_char == "*":
            in_block_comment = True
            index += 2
            continue
        if char == '"':
            string_end = index + 1
            escaped = False
            while string_end < len(text):
                if escaped:
                    escaped = False
                elif text[string_end] == "\\":
                    escaped = True
                elif text[string_end] == '"':
                    break
                string_end += 1
            if depth == 1 and string_end < len(text):
                after_key = skip_jsonc_whitespace(text, string_end + 1)
                if after_key < len(text) and text[after_key] == ":":
                    value_start = skip_jsonc_whitespace(text, after_key + 1)
                    line_start = text.rfind("\n", 0, index) + 1
                    line_end = text.find("\n", index)
                    if line_end == -1:
                        line_end = len(text)
                    line = text[line_start:line_end]
                    indent = line[: len(line) - len(line.lstrip(" \t"))]
                    last_entry = {"value_start": value_start, "indent": indent}
            index = string_end + 1
            continue
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
        index += 1
    return last_entry


def find_scalar_end(text: str, start: int) -> int:
    if start < len(text) and text[start] == '"':
        index = start + 1
        escaped = False
        while index < len(text):
            if escaped:
                escaped = False
            elif text[index] == "\\":
                escaped = True
            elif text[index] == '"':
                return index + 1
            index += 1
        raise RuntimeError("Unterminated string value in settings")
    index = start
    while index < len(text):
        if text[index] == "," or text.startswith("//", index) or text.startswith("/*", index):
            break
        if text[index] == "\n":
            break
        index += 1
    while index > start and text[index - 1].isspace():
        index -= 1
    return index


def find_value_end(text: str, start: int) -> int:
    if start >= len(text) or text[start] not in "[{":
        return find_scalar_end(text, start)
    opening = text[start]
    closing = "]" if opening == "[" else "}"
    depth = 0
    in_string = False
    escaped = False
    in_line_comment = False
    in_block_comment = False
    index = start
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""
        if in_line_comment:
            if char == "\n":
                in_line_comment = False
            index += 1
            continue
        if in_block_comment:
            if char == "*" and next_char == "/":
                in_block_comment = False
                index += 2
            else:
                index += 1
            continue
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
        elif char == "/" and next_char == "/":
            in_line_comment = True
            index += 2
            continue
        elif char == "/" and next_char == "*":
            in_block_comment = True
            index += 2
            continue
        elif char == opening:
            depth += 1
        elif char == closing:
            depth -= 1
            if depth == 0:
                return index + 1
        index += 1
    raise RuntimeError("Unterminated structured setting value")


def find_last_top_level_comment(text: str, end: int) -> int | None:
    depth = 0
    in_string = False
    escaped = False
    index = 0
    last_comment = None
    while index < end:
        char = text[index]
        next_char = text[index + 1] if index + 1 < end else ""
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
            index += 1
            continue
        if char == "/" and next_char == "/":
            if depth == 1:
                last_comment = index
            newline = text.find("\n", index + 2, end)
            index = end if newline == -1 else newline + 1
            continue
        if char == "/" and next_char == "*":
            if depth == 1:
                last_comment = index
            closing = text.find("*/", index + 2, end)
            index = end if closing == -1 else closing + 2
            continue
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
        index += 1
    return last_comment


def replace_scalar_or_add(text: str, key: str, value: object) -> str:
    entry = find_top_level_key(text, key)
    if entry is not None:
        value_end = find_scalar_end(text, entry["value_start"])
        return text[: entry["value_start"]] + json.dumps(value) + text[value_end:]

    opening = find_root_opening(text)
    closing = find_matching_brace(text, opening)
    indent = infer_top_level_indent(text, opening, closing)
    last_entry = find_last_top_level_entry(text[:closing])
    if last_entry is None:
        addition = f'\n{indent}{json.dumps(key)}: {json.dumps(value)}\n'
        return text[: opening + 1] + addition + text[opening + 1 :]
    value_end = find_value_end(text, last_entry["value_start"])
    after_value = skip_jsonc_whitespace(text, value_end)
    has_comma = after_value < closing and text[after_value] == ","
    comma = "" if has_comma else ","
    with_comma = text[:value_end] + comma + text[value_end:]
    closing += len(comma)
    addition = f'\n{indent}{json.dumps(key)}: {json.dumps(value)}\n'
    return with_comma[:closing] + addition + with_comma[closing:]


def apply_template(settings_path: Path, template_path: Path, backup_dir: Path, dry_run: bool) -> None:
    if not settings_path.exists():
        raise RuntimeError(f"VS Code settings file does not exist: {settings_path}")
    template = load_jsonc(template_path)
    current = settings_path.read_text()
    load_jsonc(settings_path)
    updated = current
    color_customizations = template.pop(COLOR_KEY, None)
    for key, value in template.items():
        if isinstance(value, (dict, list)):
            raise RuntimeError(f"Template key is not a scalar setting: {key}")
        updated = replace_scalar_or_add(updated, key, value)
    if color_customizations is None:
        raise RuntimeError(f"Template is missing {COLOR_KEY}")
    updated = replace_object(updated, COLOR_KEY, color_customizations)
    if dry_run:
        print(f"Dry run: {template_path.name} is valid and would update {settings_path}")
        return
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup_path = create_exclusive_backup(settings_path, backup_dir, "settings")
    settings_path.write_text(updated)
    print(f"Applied: {template_path.name}")
    print(f"Backup:  {backup_path}")
    print("Next:    run 'Developer: Reload Window' in VS Code")


def template_paths() -> list[Path]:
    return sorted(TEMPLATE_DIR.glob("template-*.jsonc"), key=lambda path: int(path.name.split("-")[1]))


def choose_template(paths: list[Path], settings_path: Path, backup_dir: Path) -> Path | None:
    print("\nVS Code Settings Templates")
    print("==========================")
    for index, path in enumerate(paths, start=1):
        print(f"{index:>2}. {DESCRIPTIONS.get(index, path.stem)}")
    print(" R. Restore the latest CLI backup")
    print(" Q. Quit")
    choice = input("\nChoose a template: ").strip().lower()
    if choice in {"q", "quit", ""}:
        return None
    if choice == "r":
        restore_latest(settings_path, backup_dir)
        return None
    if choice.isdigit() and 1 <= int(choice) <= len(paths):
        return paths[int(choice) - 1]
    print("Invalid choice.")
    return None


def restore_latest(settings_path: Path, backup_dir: Path) -> Path | None:
    backups = sorted(backup_dir.glob("settings-[0-9]*.json"))
    if not backups:
        print(f"No CLI backups found in {backup_dir}")
        return None
    latest = backups[-1]
    print(f"Latest backup: {latest.name}")
    if input("Restore it? [y/N] ").strip().lower() != "y":
        print("Restore cancelled.")
        return None
    backup_dir.mkdir(parents=True, exist_ok=True)
    create_exclusive_backup(settings_path, backup_dir, "settings-before-restore")
    shutil.copy2(latest, settings_path)
    print(f"Restored: {latest}")
    print("Next:    run 'Developer: Reload Window' in VS Code")
    return latest


def create_exclusive_backup(settings_path: Path, backup_dir: Path, prefix: str) -> Path:
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    for suffix in range(1000):
        suffix_text = "" if suffix == 0 else f"-{suffix}"
        backup_path = backup_dir / f"{prefix}-{timestamp}{suffix_text}.json"
        try:
            with settings_path.open("rb") as source, backup_path.open("xb") as destination:
                shutil.copyfileobj(source, destination)
            shutil.copystat(settings_path, backup_path)
            return backup_path
        except FileExistsError:
            continue
    raise RuntimeError(f"Could not create a unique backup in {backup_dir}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Switch VS Code appearance templates safely.")
    parser.add_argument("--list", action="store_true", help="list available templates")
    parser.add_argument("--template", type=int, choices=range(1, 21), help="apply template number")
    parser.add_argument("--dry-run", action="store_true", help="validate without changing settings")
    parser.add_argument("--settings-file", type=Path, default=DEFAULT_SETTINGS)
    parser.add_argument("--backup-dir", type=Path, default=BACKUP_DIR)
    args = parser.parse_args()
    paths = template_paths()
    template_ids = [int(path.name.split("-")[1]) for path in paths]
    if template_ids != list(range(1, 21)):
        print(f"Expected template IDs 1-20, found {template_ids}", file=sys.stderr)
        return 1
    if args.list:
        for index, path in enumerate(paths, start=1):
            print(f"{index}: {path.name} - {DESCRIPTIONS.get(index, path.stem)}")
        return 0
    if args.template:
        selected = paths[args.template - 1]
    else:
        selected = choose_template(paths, args.settings_file, args.backup_dir)
        if selected is None:
            return 0
    try:
        apply_template(args.settings_file, selected, args.backup_dir, args.dry_run)
    except (OSError, RuntimeError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())