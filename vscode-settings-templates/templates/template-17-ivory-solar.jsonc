{
  "workbench.colorTheme": "Default Light Modern",
  "window.autoDetectColorScheme": false,
  "workbench.preferredDarkColorTheme": "Default Light Modern",
  "workbench.preferredLightColorTheme": "Default Light Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "editor.minimap.enabled": false,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.showActions": "singleTerminal",
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.sideBar.location": "right",
  "window.density.layout": "compact",
  "workbench.activityBar.compact": true,
  "workbench.colorCustomizations": {
    "editor.background": "#FFF7D6",
    "editor.foreground": "#3A2E16",
    "editorLineNumber.foreground": "#9A8548",
    "editorLineNumber.activeForeground": "#3A2E16",
    "sideBar.background": "#FFF7D6",
    "sideBar.foreground": "#3A2E16",
    "sideBar.border": "#E0CF91",
    "panel.background": "#FFF7D6",
    "panel.border": "#E0CF91",
    "titleBar.activeBackground": "#FFF7D6",
    "titleBar.activeForeground": "#3A2E16",
    "activityBar.background": "#FFF7D6",
    "activityBar.foreground": "#3A2E16",
    "activityBar.inactiveForeground": "#9A8548",
    "statusBar.background": "#FFF7D6",
    "statusBar.foreground": "#3A2E16",
    "editorGroupHeader.tabsBackground": "#FFF7D6",
    "tab.activeBackground": "#FFF7D6",
    "tab.activeForeground": "#3A2E16",
    "tab.inactiveBackground": "#F2E8B5",
    "tab.inactiveForeground": "#888888",
    "input.background": "#FFFBEA",
    "dropdown.background": "#FFFBEA",
    "list.background": "#FFF7D6",
    "list.hoverBackground": "#F5EAAE",
    "list.activeSelectionBackground": "#E8CF5A",
    "focusBorder": "#B8860B",
    "terminal.background": "#FFF7D6",
    "terminal.foreground": "#3A2E16",
    "terminalCursor.background": "#3A2E16",
    "terminalCursor.foreground": "#FFF7D6",
    "terminal.ansiBlack": "#403515",
    "terminal.ansiBlue": "#B8860B",
    "terminal.ansiBrightBlack": "#9A8548",
    "terminal.ansiBrightBlue": "#B8860B",
    "terminal.ansiBrightCyan": "#4EC9B0",
    "terminal.ansiBrightGreen": "#B5CEA8",
    "terminal.ansiBrightMagenta": "#C586C0",
    "terminal.ansiBrightRed": "#F48771",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "terminal.ansiBrightYellow": "#DCB67A",
    "terminal.ansiCyan": "#4EC9B0",
    "terminal.ansiGreen": "#608B4E",
    "terminal.ansiMagenta": "#C586C0",
    "terminal.ansiRed": "#D16969",
    "terminal.ansiWhite": "#3A2E16",
    "terminal.ansiYellow": "#D7BA7D"
  }
}
