{
  "workbench.colorTheme": "Default Dark Modern",
  "window.autoDetectColorScheme": false,
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "editor.minimap.enabled": false,
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Menlo', 'Monaco', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.showActions": "singleTerminal",
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.sideBar.location": "right",
  "window.density.layout": "compact",
  "workbench.activityBar.compact": true,
  "workbench.colorCustomizations": {
    "editor.background": "#0B0F0D",
    "editor.foreground": "#E7F0EA",
    "editorLineNumber.foreground": "#63736B",
    "editorLineNumber.activeForeground": "#E7F0EA",
    "sideBar.background": "#0B0F0D",
    "sideBar.foreground": "#E7F0EA",
    "sideBar.border": "#24382D",
    "panel.background": "#0B0F0D",
    "panel.border": "#24382D",
    "titleBar.activeBackground": "#0B0F0D",
    "titleBar.activeForeground": "#E7F0EA",
    "activityBar.background": "#0B0F0D",
    "activityBar.foreground": "#B7F000",
    "activityBar.inactiveForeground": "#63736B",
    "statusBar.background": "#15251B",
    "statusBar.foreground": "#E7F0EA",
    "editorGroupHeader.tabsBackground": "#0B0F0D",
    "tab.activeBackground": "#15251B",
    "tab.activeForeground": "#E7F0EA",
    "tab.inactiveBackground": "#181818",
    "tab.inactiveForeground": "#888888",
    "input.background": "#15251B",
    "dropdown.background": "#15251B",
    "list.background": "#0B0F0D",
    "list.hoverBackground": "#1D3A29",
    "list.activeSelectionBackground": "#2F5B3D",
    "focusBorder": "#7DD9FF",
    "terminal.background": "#0B0F0D",
    "terminal.foreground": "#E7F0EA",
    "terminalCursor.background": "#E7F0EA",
    "terminalCursor.foreground": "#0B0F0D",
    "terminal.ansiBlack": "#0B0F0D",
    "terminal.ansiBlue": "#7DD9FF",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightBlue": "#569CD6",
    "terminal.ansiBrightCyan": "#7DD9FF",
    "terminal.ansiBrightGreen": "#B7F000",
    "terminal.ansiBrightMagenta": "#C586C0",
    "terminal.ansiBrightRed": "#FF8585",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "terminal.ansiBrightYellow": "#D9F99D",
    "terminal.ansiCyan": "#65C7E8",
    "terminal.ansiGreen": "#8CCF4D",
    "terminal.ansiMagenta": "#C586C0",
    "terminal.ansiRed": "#D16969",
    "terminal.ansiWhite": "#E7F0EA",
    "terminal.ansiYellow": "#D7BA7D"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {"scope": "markup.heading.markdown", "settings": {"foreground": "#B7F000", "fontStyle": "bold"}},
      {"scope": "markup.heading.1.markdown", "settings": {"foreground": "#B7F000", "fontStyle": "bold"}},
      {"scope": "markup.heading.2.markdown", "settings": {"foreground": "#C9FF4D", "fontStyle": "bold"}},
      {"scope": "markup.heading.3.markdown", "settings": {"foreground": "#D9F99D", "fontStyle": "bold"}},
      {"scope": "markup.heading.4.markdown", "settings": {"foreground": "#7DD9FF", "fontStyle": "bold"}},
      {"scope": "markup.heading.5.markdown", "settings": {"foreground": "#9BE3FF", "fontStyle": "bold"}},
      {"scope": "markup.heading.6.markdown", "settings": {"foreground": "#B8ECFF", "fontStyle": "bold"}},
      {"scope": ["markup.underline.link.markdown", "string.other.link"], "settings": {"foreground": "#7DD9FF", "fontStyle": "underline"}},
      {"scope": "markup.bold.markdown", "settings": {"foreground": "#E7F0EA", "fontStyle": "bold"}},
      {"scope": "markup.inline.raw.markdown", "settings": {"foreground": "#B7F000"}},
      {"scope": "markup.quote.markdown", "settings": {"foreground": "#9BE3FF", "fontStyle": "italic"}}
    ]
  }
}
